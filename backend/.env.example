# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=lexinit_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_REFRESH_EACH_REQUEST=true
SERVER_SESSION_COLLECTION=server_sessions
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=240
SOURCE_UPLOAD_RATE_LIMIT=15
GENERATION_START_RATE_LIMIT=10
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERT_WINDOW_SECONDS=300
ALERT_MIN_REQUESTS=20
ALERT_ERROR_RATE_PERCENT=2
ALERT_P95_DURATION_MS=2000

# Database
USE_LOCAL_MONGO=false
LOCAL_MONGO_URI=mongodb://localhost:27017/lexinit
MONGO_URI=mongodb+srv://rsrsp21:<db_password>@cluster0.hd1uz5i.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=lexinit
MONGO_DNS_NAMESERVERS=
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

# Durable generation workers
# Leave REDIS_URL empty for the automatic local worker used in development.
# Set it in production and run `uv run python worker.py` in a separate process.
REDIS_URL=
GENERATION_WORKER_MODE=auto
GENERATION_QUEUE_NAME=generation
GENERATION_LEASE_SECONDS=900
GENERATION_RESUME_ON_STARTUP=true

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=lexinit.inc@gmail.com
MAIL_PASSWORD=replace-with-mail-app-password
MAX_CONTENT_LENGTH=12582912
MAIL_SUPPRESS_SEND=false
SIGNUP_OTP_TTL_SECONDS=300
SIGNUP_RESEND_COOLDOWN_SECONDS=30
SIGNUP_DRAFT_TTL_SECONDS=900
SIGNUP_MAX_CODE_ATTEMPTS=5
PASSWORD_RESET_OTP_TTL_SECONDS=300
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=30
PASSWORD_RESET_MAX_CODE_ATTEMPTS=5

# AI and Search Providers
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
GEMINI_DEEP_FOCUS_MODEL_NAME=gemini-2.5-pro
GEMINI_FALLBACK_MODEL_NAMES=gemini-2.5-flash
YOUTUBE_API_KEY=replace-with-youtube-api-key
CUSTOM_SEARCH_API=replace-with-google-custom-search-api-key
SEARCH_ID=replace-with-google-custom-search-engine-id

# Google Cloud Vision credentials as base64-encoded service-account JSON.
GOOGLE_CREDENTIALS_BASE64=replace-with-base64-service-account-json
